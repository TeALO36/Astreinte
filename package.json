{
  "name": "snap-astreinte",
  "version": "0.1.0",
  "description": "Persona de messagerie : vous définissez un personnage (nom, personnalité, voix, garde-fous) et il répond seul sur Telegram ou Snapchat, avec un contexte isolé par interlocuteur et des notes vocales générées par TTS. Inclut SnapMCP, un serveur MCP pour contrôler Snapchat ou Telegram (messages, médias, notes vocales, appels).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snap-astreinte": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist", "scripts", "Lancer-Banc-SnapMCP.bat", "Lancer-VMs-Android.bat", "plugin.json", ".claude-plugin", "gemini-extension.json", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js daemon",
    "prepublishOnly": "npm run build",
    "mcp": "node dist/index.js mcp",
    "snapmcp": "node dist/snapmcp.js",
    "test-bench": "node scripts/test-bench-app.mjs",
    "android:vms": "node scripts/android-vms.mjs",
    "android:vms:headless": "node scripts/android-vms.mjs --no-window",
    "android:vms:stop": "node scripts/android-vms.mjs --check-only --quit-after-check",
    "smoke": "node scripts/smoke-test.mjs",
    "telegram:login": "node scripts/telegram-login.mjs",
    "test": "tsc && node --test --test-timeout=25000 --test-force-exit dist/snap-astreinte.test.js dist/e2e.test.js dist/client-adapter.test.js && node scripts/smoke-test.mjs",
    "check": "node dist/index.js check"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "persona",
    "chatbot",
    "claude-code-plugin",
    "gemini-cli-extension",
    "snapchat",
    "telegram",
    "tts"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "^1.62.1",
    "telegram": "^2.26.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
